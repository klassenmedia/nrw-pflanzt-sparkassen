---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import IslandStage from '../components/IslandStage.astro';
import skRot from '../assets/logos/sparkassen-rheinland-rot.png';
import rgGruen from '../assets/logos/robin-gut-gruen.png';
import nrwDunkel from '../assets/logos/nrw-pflanzt-dunkel.png';
import { BEISPIELDATEN, datenstand, eintraege } from '../data/sparkassen.ts';
import {
  FILTERS,
  STATUS_LABEL,
  TREE_GOAL,
  datumLang,
  fortschrittProzent,
  heuteIso,
  kennzahlen,
  naechsterTermin,
  statusAm,
  stichtag,
  terminKandidaten,
  terminText,
  treesForProgress,
  type TerminArt,
} from '../lib/kennzahlen.ts';

// Ausgeblendet, bis O-Töne von Schülern und vom RSGV vorliegen (Andreas, 07.10.2026). Zum Einblenden auf true.
const ZEIGE_STIMMEN = false;
const fmt = new Intl.NumberFormat('de-DE');
const heute = heuteIso(new Date());
const stand = stichtag(heute, datenstand.stand);
const k = kennzahlen(eintraege, stand);
// Hauptzahl sind die zugesagten Bäume (Guidos Summe); gepflanzt steht klein darunter.
const zugesagt = datenstand.baeumeZugesagt;
const fortschritt = fortschrittProzent(zugesagt);
const ziel = fmt.format(TREE_GOAL);
const kacheln = eintraege.map((e) => ({ ...e, status: statusAm(e, stand) }));

// Stand des Builds; das Browser-Skript wählt mit dem echten Heute neu, falls länger kein Build kam.
const TERMIN_LABEL: Record<TerminArt, string> = { schulaktionstag: 'Nächster Schulaktionstag', pflanztag: 'Nächster Pflanztag' };
const termine = (['schulaktionstag', 'pflanztag'] as const).map((art) => {
  const kandidaten = terminKandidaten(eintraege, art);
  const naechster = naechsterTermin(kandidaten, heute);
  return { art, label: TERMIN_LABEL[art], text: naechster ? terminText(naechster) : '', kandidaten: JSON.stringify(kandidaten) };
});

const partner = [
  { name: 'Sparkassen im Rheinland', logo: skRot },
  { name: 'ROBIN GUT Stiftung', logo: rgGruen },
  { name: 'NRW pflanzt', logo: nrwDunkel },
];
// Laufband: Satz mehrfach, damit die Spur breiter als der Bildschirm ist; Hälfte zwei ist die nahtlose Kopie.
const MARQUEE_REPEATS = 4;
const marqueeHalf = Array.from({ length: MARQUEE_REPEATS }, (_, round) => partner.map((p) => ({ ...p, copy: round > 0 }))).flat();
const marqueeItems = [...marqueeHalf, ...marqueeHalf.map((p) => ({ ...p, copy: true }))];

const werte = [
  { icon: 'pin', green: false, title: 'Lokal verwurzelt', sk: 'in der Region, für die Menschen der Region.', rg: 'Jede Spende wirkt lokal, gepflanzt wird in der eigenen Kommune.' },
  { icon: 'eye', green: false, title: 'Sichtbar engagiert', sk: 'Engagement, das man vor Ort sehen und erleben kann.', rg: 'Schulaktionstag, Pflanztag und Partnerschild auf jeder Fläche.' },
  { icon: 'leaf', green: true, title: 'Ökologisch und sozial', sk: 'öffentlicher Auftrag und Gemeinwohl als Teil des Selbstverständnisses.', rg: 'Aufforstung, Umweltbildung und soziale Projekte aus einer Hand.' },
  { icon: 'sprout', green: true, title: 'Für die nächste Generation', sk: 'Perspektiven für junge Menschen in der Region.', rg: 'Kinder und Jugendliche gestalten eine enkelfähige Zukunft mit.' },
] as const;

const ablauf = [
  { title: 'Kommune und Fläche finden', text: 'In jedem Sparkassengebiet suchen wir mit Kommune und Forst mindestens eine passende Pflanzfläche.' },
  { title: 'Schulaktionstag', text: 'ROBIN GUT kommt an die Schule, mit Wissen rund um Wald und Klima. Die Sparkasse vor Ort ist dabei.' },
  { title: 'Pflanztag', text: 'Kinder, Sparkassen-Team und Förster pflanzen gemeinsam. Das Partnerschild bleibt auf der Fläche stehen.' },
  { title: 'Pflege und Bericht', text: 'Drei Jahre Kulturpflege. Jeder Fortschritt erscheint hier auf dieser Seite.' },
];


---

<Base
  title="NRW pflanzt · Die rheinischen Sparkassen"
  description={`Die rheinischen Sparkassen pflanzen mit der ROBIN GUT Stiftung ${ziel} klimafitte Bäume in 27 Regionen, gemeinsam mit Kindern und Jugendlichen.`}
>
  <section class="sk-hero">
    <div class="sk-hero__inner">
      <div class="sk-hero__copy">
        <span class="sk-eyebrow">NRW pflanzt · Die rheinischen Sparkassen</span>
        <h1 class="sk-h1"><span class="sk-line">{ziel} Bäume.</span> <span class="sk-line">27 Regionen.</span> <span class="sk-line sk-line--soft">Eine Generation, die anpackt.</span></h1>
        <p class="sk-lead">
          Die rheinischen Sparkassen pflanzen gemeinsam mit der ROBIN GUT Stiftung {ziel} klimafitte Bäume, unterstützt vom Rheinischen Sparkassen- und Giroverband. Gepflanzt von Kindern und Jugendlichen, direkt in ihrer eigenen Kommune.
        </p>
        <div class="sk-hero__actions">
          <a class="sk-btn" href="#regionen">Ihre Sparkasse finden <Icon name="arrow" /></a>
          <a class="sk-btn sk-btn--ghost" href="#werte">Was uns verbindet</a>
        </div>
      </div>
      <IslandStage trees={treesForProgress(fortschritt)} stage={3} label="Drehende 3D-Insel mit jungem Mischwald und Partnerschild">
        <div class="sk-float sk-float--b">
          <span class="sk-float__label">Bäume zugesagt</span>
          <span class="sk-float__value">{fmt.format(zugesagt)} von {ziel}</span>
        </div>
        <div class="sk-float-stack">
          {
            termine.map((t) => (
              <div class="sk-float" data-termin={t.art} data-kandidaten={t.kandidaten} hidden={!t.text}>
                <span class="sk-float__label">{t.label}</span>
                <span class="sk-float__value" data-termin-text>{t.text}</span>
              </div>
            ))
          }
        </div>
      </IslandStage>
    </div>
  </section>

  <section class="sk-partners" aria-label="Partner">
    <div class="sk-wrap sk-partners__inner">
      <span class="sk-partners__label">Gemeinsam mit</span>
      <div class="sk-marquee" role="group" tabindex="0" aria-label="Partnerlogos. Antippen oder mit der Tab-Taste auswählen hält das Laufband an.">
        <ul class="sk-marquee__track">
          {
            marqueeItems.map((item) => (
              <li class="sk-marquee__item" aria-hidden={item.copy ? 'true' : undefined}>
                <img src={item.logo.src} width={item.logo.width} height={item.logo.height} alt={item.copy ? '' : item.name} loading="lazy" decoding="async" />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section id="werte" class="sk-section sk-section--surface">
    <div class="sk-wrap" style="display:flex;flex-direction:column;gap:48px">
      <div class="sk-head">
        <span class="sk-eyebrow">Was uns verbindet</span>
        <h2 class="sk-h2">Vor Ort. Sichtbar. Nachhaltig, ökologisch und sozial.</h2>
        <p class="sk-lead">
          Die Sparkassen sind in ihrer Region zu Hause und übernehmen dort Verantwortung. ROBIN GUT pflanzt dort, wo Menschen leben, und verbindet Klimaschutz mit Bildung und sozialem Engagement. NRW pflanzt bringt beides zusammen.
        </p>
      </div>
      <div class="sk-grid-4">
        {
          werte.map((w) => (
            <article class="sk-value sk-tilt">
              <span class:list={['sk-value__icon', { 'sk-value__icon--green': w.green }]}>
                <Icon name={w.icon} />
              </span>
              <h3 class="sk-h3">{w.title}</h3>
              <p><strong>Sparkasse:</strong> {w.sk}</p>
              <p><strong>ROBIN GUT:</strong> {w.rg}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sk-section sk-band" aria-labelledby="zaehler-titel">
    <div class="sk-wrap sk-band__inner">
      <h2 id="zaehler-titel" class="sk-band__title">Gemeinsam Zukunft pflanzen</h2>
      <div class="sk-counter">
        <div class="sk-counter__top">
          <div style="display:flex;flex-direction:column;gap:10px">
            <span class="sk-counter__label">Bäume zugesagt</span>
            <div>
              <span class="sk-num sk-counter__big" data-count={zugesagt}>{fmt.format(zugesagt)}</span>
              <span class="sk-num sk-counter__goal"> von {ziel}</span>
            </div>
            <span class="sk-counter__geplant">
              davon gepflanzt: <span class="sk-num">{fmt.format(k.gepflanzt)}</span>
              {k.pflanztageGeplant > 0 && ` · ${k.pflanztageGeplant} ${k.pflanztageGeplant === 1 ? 'Pflanztag' : 'Pflanztage'} geplant`}
            </span>
          </div>
          <span class="sk-counter__meta">Stand der Tabelle: {datumLang(datenstand.stand)}{BEISPIELDATEN && ' · Beispieldaten'}</span>
        </div>
        <div
          class="sk-bar"
          role="progressbar"
          aria-label={`Fortschritt bis ${ziel} Bäume`}
          aria-valuetext={`${fmt.format(zugesagt)} von ${ziel} Bäumen zugesagt, davon ${fmt.format(k.gepflanzt)} gepflanzt`}
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow={fortschritt}
          style={`--sk-progress:${fortschritt}%`}
        >
          <span class="sk-bar__fill"></span>
        </div>
        <div class="sk-kpis">
          <div class="sk-kpi"><span class="sk-num">{fmt.format(k.sparkassenGesamt)}</span><span>Sparkassen dabei</span></div>
          <div class="sk-kpi"><span class="sk-num">{fmt.format(k.kommunenDabei)}</span><span>Städte und Gemeinden dabei</span></div>
          <div class="sk-kpi">
            <span class="sk-num">
              {fmt.format(k.schulaktionstage)}
              {k.schulaktionstageGeplant > 0 && <span class="sk-kpi__geplant">+{k.schulaktionstageGeplant} geplant</span>}
            </span>
            <span>Schulaktionstage</span>
          </div>
          <div class="sk-kpi"><span class="sk-num">{fmt.format(k.kinder)}</span><span>Kinder und Jugendliche dabei</span></div>
        </div>
      </div>
    </div>
  </section>

  <section id="regionen" class="sk-section">
    <div class="sk-wrap" style="display:flex;flex-direction:column;gap:32px">
      <div class="sk-head sk-head--row">
        <div class="sk-head">
          <span class="sk-eyebrow">Die Sparkassen im Projekt</span>
          <h2 class="sk-h2">Jede Sparkasse. Ihr eigener Wald.</h2>
          <p class="sk-lead">
            In jedem Geschäftsgebiet pflanzen wir in mindestens einer Kommune. Die Farbe zeigt, wie weit jede Sparkasse ist.
          </p>
        </div>
        <div class="sk-filters" role="group" aria-label="Sparkassen nach Stand hervorheben">
          {
            FILTERS.map((f) => (
              <button class="sk-filter" type="button" data-filter={f.value} aria-pressed={f.value === 'alle' ? 'true' : 'false'}>
                {f.label}
              </button>
            ))
          }
        </div>
      </div>
      <ul class="sk-tiles">
        {
          kacheln.map((e, i) => (
            <li class="sk-tile" data-status={e.status}>
              <span class="sk-num sk-tile__nr">{String(i + 1).padStart(2, '0')}</span>
              <span style="display:flex;flex-direction:column;gap:2px">
                <span class="sk-tile__name">{e.sparkasse}</span>
                <span class="sk-tile__place">{e.kommune}</span>
                <span class="sk-tile__status">{STATUS_LABEL[e.status]}</span>
              </span>
            </li>
          ))
        }
      </ul>
      <div class="sk-legend">
        <span><i style="background:#eeeeee"></i>In Planung</span>
        <span><i style="background:#f9c9c9"></i>Schulaktionstag erfolgt</span>
        <span><i style="background:#3e721d"></i>Gepflanzt</span>
        {BEISPIELDATEN && <span>Beispieldaten</span>}
        <span data-filter-status aria-live="polite"></span>
      </div>
    </div>
  </section>

  <section id="ablauf" class="sk-section sk-section--surface">
    <div class="sk-wrap" style="display:flex;flex-direction:column;gap:56px">
      <div class="sk-head">
        <span class="sk-eyebrow">So läuft’s ab</span>
        <h2 class="sk-h2">Von der Idee bis zum jungen Wald, in vier Schritten.</h2>
      </div>
      <ol class="sk-steps">
        {
          ablauf.map((s, i) => (
            <li class="sk-step">
              <span class="sk-orb" aria-hidden="true">{i + 1}</span>
              <h3 class="sk-h3">{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    ZEIGE_STIMMEN && (
      <section id="stimmen" class="sk-section">
        <div class="sk-wrap" style="display:flex;flex-direction:column;gap:40px">
          <div class="sk-head">
            <span class="sk-eyebrow">Kinder im Mittelpunkt</span>
            <h2 class="sk-h2">Klimaschutz, den man anfassen kann. Mit Gesichtern.</h2>
          </div>
          <div class="sk-quotes">
            <figure class="sk-quote sk-quote--green sk-tilt">
              <span class="sk-quote-mark" aria-hidden="true">“</span>
              <blockquote>„[Zitat einer Schülerin oder eines Schülers vom Pflanztag]“</blockquote>
              <figcaption>[Vorname], Klasse [x], [Schule] · Region Sparkasse [Name]</figcaption>
            </figure>
            <figure class="sk-quote sk-tilt">
              <span class="sk-quote-mark" aria-hidden="true" style="color:var(--sk-red)">“</span>
              <blockquote>„[Warum der Rheinische Sparkassen- und Giroverband NRW pflanzt unterstützt]“</blockquote>
              <figcaption>
                <span class="sk-avatar"></span>
                <span><strong>[Name]</strong><br />[Funktion], Rheinischer Sparkassen- und Giroverband</span>
              </figcaption>
            </figure>
          </div>
        </div>
      </section>
    )
  }


  <section id="mittel" class="sk-section">
    <div class="sk-wrap sk-funds">
      <div class="sk-funds__copy">
        <span class="sk-eyebrow">Wirkung und Transparenz</span>
        <h2 class="sk-h2">Wo jeder Euro hinwächst.</h2>
        <p class="sk-lead">
          Für 20 Euro pflanzen wir einen Baum, in der Regel 60 bis 80 Zentimeter groß. Der Baum selbst ist dabei der kleinste Posten. Damit er anwächst und durchkommt, gehören die Pflanzung, Verbissschutz gegen Wild und drei Jahre Kulturpflege dazu. Ein fester Anteil fließt in Bildung und soziale Projekte vor Ort.
        </p>
        <div class="sk-mini-cards">
          <div class="sk-mini"><strong>Mit dem Forst abgestimmt</strong><span>Fläche und Baumarten wählen wir mit der örtlichen Forstverwaltung.</span></div>
          <div class="sk-mini"><strong>Ehrlich gerechnet</strong><span>Jeder Setzling braucht Zeit. Darum begleiten wir jede Fläche drei Jahre.</span></div>
        </div>
      </div>
      <div class="sk-funds__viz">
        <ul class="sk-funds__list">
          <li>
            <span class="sk-swatch" style="background:#3e721d"></span>
            <div><div class="sk-funds__title">Pflanzung</div><p>Baum aus der Forstbaumschule Lürssen mit gesicherter Herkunft und die Pflanzung selbst.</p></div>
          </li>
          <li>
            <span class="sk-swatch" style="background:#88b225"></span>
            <div><div class="sk-funds__title">Schutz und Pflege</div><p>Verbissschutz gegen Wild und drei Jahre Kulturpflege.</p></div>
          </li>
          <li>
            <span class="sk-swatch" style="background:#e30513"></span>
            <div><div class="sk-funds__title">Bildung und soziale Projekte</div><p>Umweltbildung, Schulprojekte und gemeinnützige Maßnahmen vor Ort.</p></div>
          </li>
        </ul>
      </div>
    </div>
  </section>


</Base>
