---
import { STAND_OPTIONS } from '../lib/projektstand.ts';

// Nur für die Abstimmung des Entwurfs. Beim Build ohne Steuerung: PUBLIC_ENTWURF=false.
interface Props {
  mode: 'progress' | 'stand';
  value: number | string;
}

const { mode, value } = Astro.props;
const enabled = import.meta.env.PUBLIC_ENTWURF !== 'false';
---

{
  enabled && (
    <details class="sk-draft" open data-draft>
      <summary>Entwurfs-Steuerung</summary>
      {mode === 'progress' ? (
        <>
          <label for="draft-progress">
            Entwurf: Fortschritt <output id="draft-progress-value" for="draft-progress">{value} %</output>
          </label>
          <input id="draft-progress" type="range" min="0" max="100" step="1" value={value} />
        </>
      ) : (
        <>
          <label for="draft-stand">Entwurf: Projektstand</label>
          <select id="draft-stand">
            {STAND_OPTIONS.map((option) => (
              <option value={option} selected={option === value}>
                {option}
              </option>
            ))}
          </select>
        </>
      )}
      <small>Nur im Entwurf sichtbar, zeigt die Dynamik der Seite.</small>
    </details>
  )
}
